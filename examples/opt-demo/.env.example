OPENAI_API_KEY=sk-...
# Optional: which OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# Axis 3 — SLM mode (NLLB/BART/Qwen3 local models)
AXIS3_SLM_ENABLED=false
AXIS3_SLM_SERVER_URL=http://localhost:8001

# Ollama mode — local model via Ollama (overrides OpenAI + SLM when true)
OLLAMA_ENABLED=false
OLLAMA_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434
