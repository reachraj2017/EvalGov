# =============================================================================
# opt-aieval — Environment Configuration
# Copy this file to .env and fill in the required values.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------

# Required: used by the LLM judge evaluators and the EvalGov chat agent
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: required only if your demo agents use OpenAI models
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Model Selection
# -----------------------------------------------------------------------------

# Model used by the eval-runner LLM judges
# Prefix determines the provider: anthropic/ openai/ ollama/
# Default: anthropic/claude-haiku-4-5-20251001  (fast, low cost for judging)
JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# Model used by the EvalGov chat agent and RCA generator
# Default: anthropic/claude-sonnet-4-6  (higher quality for analysis)
AGENT_MODEL=anthropic/claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Ollama (local models — optional)
# -----------------------------------------------------------------------------

# Base URL for Ollama if using local models (e.g. ollama/gemma4:26b)
# Only needed if JUDGE_MODEL or AGENT_MODEL uses the ollama/ prefix
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# EvalGov Agent Behaviour
# -----------------------------------------------------------------------------

# How often the proactive monitor polls for anomalies (seconds)
# Default: 60
MONITOR_POLL_SECONDS=60

# Minutes before an unresolved HITL request triggers a finding
# Default: 15
HITL_TIMEOUT_MINUTES=15

# -----------------------------------------------------------------------------
# ClickHouse
# All services inside Docker connect via the container name (clickhouse:9000).
# These variables are used when connecting from your local machine or agent code.
# -----------------------------------------------------------------------------

# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000       # native TCP port (used by Python clickhouse-driver)
# CLICKHOUSE_DB=otel
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Service URLs
# Inside Docker, services communicate via container names.
# Only override these if you are running services outside Docker.
# -----------------------------------------------------------------------------

# EVAL_RUNNER_URL=http://localhost:8000
# GOVERNANCE_SERVICE_URL=http://localhost:8002
# EVALGOV_AGENT_URL=http://localhost:8003

# -----------------------------------------------------------------------------
# OTel Collector (for agent instrumentation)
# Set this in your agent's environment, not in this file.
# gRPC: localhost:4317  |  HTTP: localhost:4318
# Inside Docker networks use: http://otel-collector:4317
# -----------------------------------------------------------------------------

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
